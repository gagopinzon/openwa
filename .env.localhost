# =============================================================================
# Máquina LOCAL aislada — sin panel, sin URLs públicas de producción.
# Copiar a .env en esa máquina:  cp .env.localhost .env
# =============================================================================

PORT=3445
TEST_MODE=false

# --- MongoDB local (sin auth) ---
MONGODB_URI=mongodb://127.0.0.1:27017/msg_db

# --- Webhooks: URL vista DESDE OpenWA (contenedor Docker), no desde el host ---
# 127.0.0.1 dentro de openwa-api es el contenedor → fetch failed.
# Comprobado en DESKTOP-JKAEEDK: desde openwa-api, 172.17.0.1:3445 responde.
# OBLIGATORIO en el .env / compose de OpenWA (no de msg), si no SSRF rechaza la IP:
#   SSRF_ALLOWED_HOSTS=172.17.0.1
#   WEBHOOK_SSRF_PROTECT=true
# (alternativa en red cerrada: WEBHOOK_SSRF_PROTECT=false)
# Reinicia el contenedor openwa-api y luego Reactivar webhooks en msg.
WEBHOOK_PUBLIC_URL=http://172.17.0.1:3445
# Si agendás contra el panel de producción, el CV debe ser descargable desde internet:
# CV_PUBLIC_URL=https://msg.protalentconnections.com
WEBHOOK_SECRET=AAAAC3NzaC1lZDI1NTE5AAAAIF36fZrOz3pc8yirCxxO2XTXN96Rt3lbba6TXWKb/5Wc
AUTO_ACTIVATE_WEBHOOKS=true
# Fallback si el POST de OpenWA sigue fallando: poll → mismo pipeline de webhooks
OPENWA_INBOX_POLL=true
OPENWA_INBOX_POLL_MS=3000

# --- OpenWA local (ajusta puerto si el tuyo es otro) ---
OPENWA_BASE_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=CAMBIAR_POR_TU_API_KEY_OPENWA_LOCAL

# --- Auto-respuesta: Ollama (Mónica) o DeepSeek ---
AI_REPLY_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma4:12b
# OLLAMA_TIMEOUT_MS=120000
OLLAMA_THINK=false

# DeepSeek solo si AI_REPLY_PROVIDER=deepseek (mensajes masivos / CVs)
# DEEPSEEK_API_KEY=

AUTO_REPLY_ENABLED=true
# true = responde al instante (sin visto/escribiendo). false = máx. 3s de "escribiendo…"
AUTO_REPLY_SKIP_DELAYS=false
AUTO_REPLY_SEEN_DELAY_MS=600
AUTO_REPLY_TYPING_AFTER_SEEN_MS=300
AUTO_REPLY_MIN_DELAY_MS=400
AUTO_REPLY_MAX_DELAY_MS=3000
AUTO_REPLY_TYPING_BASE_MS=400
AUTO_REPLY_TYPING_MS_PER_CHAR=15

# --- Envío masivo (este repo usa SEND_*, no BULK_*) ---
SEND_MIN_DELAY_SEC=60
SEND_MAX_DELAY_SEC=300
SEND_FAILOVER_HEALTH_RETRIES=3
SEND_FAILOVER_HEALTH_WAIT_MS=20000
SEND_FAILOVER_LOCAL_RETRIES=2

# --- Previews de conversaciones ---
CONVERSATIONS_PREVIEW_DELAY_MS=4000
CONVERSATIONS_PREVIEW_BATCH=3

# --- Android gateway (solo si usas la app agente en celular) ---
ANDROID_GATEWAY_TOKEN=1122334455

# --- Panel: vacío en máquina aislada ---
PANEL_BASE_URL=
MSG_INTEGRATION_API_KEY=
MSG_GERENTE_EMAIL=

# --- Hermes / bridge local (mismo PC o Windows → WSL) ---
HERMES_BRIDGE_TOKEN=genera-con-openssl-rand-hex-32

# --- DeepSeek: opcional; solo si esa máquina tiene salida a internet ---
# DEEPSEEK_API_KEY=

# --- Auth web (opcional en local) ---
# AUTH_USERNAME=admin
# AUTH_PASSWORD=cambiar