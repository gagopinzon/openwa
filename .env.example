# Copiar a .env y completar valores.

# Autenticación de la interfaz web (si ambos están definidos, el login es obligatorio)
AUTH_USERNAME=mrgago
AUTH_PASSWORD=A4s5d6a4s5d6.0
# Opcional — firma de sesión (si no se define, se usa OPENWA_API_KEY)
# AUTH_SESSION_SECRET=

# Puerto del servidor Express
PORT=3445

# Modo simulación (no envía por WhatsApp real)
TEST_MODE=false

# API key de DeepSeek para generar mensajes con IA
DEEPSEEK_API_KEY=

# OpenWA — gateway en openwa.protalentconnections.com
OPENWA_BASE_URL=https://whatsapp.protalentconnections.com/api
OPENWA_API_KEY=owa_k1_598c8ea2bdd781762b89d47dfa1ee7dc65c1e8f054bab172db0fad0ad25d82f4

# Las sesiones WhatsApp se configuran en la interfaz web (se guardan en data/sessions.json).
# Solo si el archivo está vacío al primer arranque, se importan desde estas variables:
# OPENWA_SESSION_SESSION1=
# OPENWA_SESSION_SESSION2=
# OPENWA_SESSION_SESSION3=
# OPENWA_SESSION_ID=

# Historial de contactos (base separada del proyecto Puppeteer)
# MONGODB_URI=mongodb://whatsapp_app:TU_PASSWORD@localhost:27017/whatsapp_bulk_openwa?authSource=whatsapp_bulk_openwa
# MONGODB_URI=

# Auto-respuesta IA (webhooks OpenWA)
# URL pública HTTPS donde OpenWA puede enviar eventos (mismo servidor detrás de nginx)
# También la usa el panel para descargar CVs al agendar reuniones (/api/public/cv/:id)
WEBHOOK_PUBLIC_URL=
WEBHOOK_SECRET=
AUTO_REPLY_ENABLED=false
AUTO_REPLY_MIN_DELAY_MS=3000
AUTO_REPLY_MAX_DELAY_MS=8000
# Si true (default), al llegar un mensaje de alguien que no está en Mongo se da de alta solo
# (incluye contactos @lid de WhatsApp) para que la IA pueda contestar.
AUTO_REPLY_ENROLL_UNKNOWN=true

# Integración Panel — agendar reuniones (misma clave que MSG_INTEGRATION_API_KEY en panel)
PANEL_BASE_URL=https://panel.protalentconnections.com
MSG_INTEGRATION_API_KEY=
# Opcional: fallback si el usuario no guardó su correo en el perfil de la UI
MSG_GERENTE_EMAIL=
