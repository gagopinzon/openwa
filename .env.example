# Copiar a .env y completar valores.

# Autenticación de la interfaz web (si ambos están definidos, el login es obligatorio)
AUTH_USERNAME=mrgago
AUTH_PASSWORD=A4s5d6a4s5d6.0
# Opcional — firma de sesión (si no se define, se usa OPENWA_API_KEY)
# AUTH_SESSION_SECRET=

# Puerto del servidor Express
PORT=3445

# Modo simulación (no envía por WhatsApp real)
TEST_MODE=false

# API key de DeepSeek para generar mensajes con IA
DEEPSEEK_API_KEY=

# OpenWA — gateway en openwa.protalentconnections.com
OPENWA_BASE_URL=https://whatsapp.protalentconnections.com/api
OPENWA_API_KEY=owa_k1_598c8ea2bdd781762b89d47dfa1ee7dc65c1e8f054bab172db0fad0ad25d82f4

# Las sesiones WhatsApp se configuran en la interfaz web (se guardan en data/sessions.json).
# Solo si el archivo está vacío al primer arranque, se importan desde estas variables:
# OPENWA_SESSION_SESSION1=
# OPENWA_SESSION_SESSION2=
# OPENWA_SESSION_SESSION3=
# OPENWA_SESSION_ID=

# Historial de contactos (base separada del proyecto Puppeteer)
# MONGODB_URI=mongodb://whatsapp_app:TU_PASSWORD@localhost:27017/whatsapp_bulk_openwa?authSource=whatsapp_bulk_openwa
# MONGODB_URI=

# Hermes Agent (daemon en Windows) — polling del inbox WSL sin login de la UI
# GET  /api/hermes/inbox?since=ISO8601
# POST /api/hermes/ack  { "ids": ["inbox_..."], "status": "meeting_scheduled", "replyMessage": "..." }
# Header: X-Hermes-Token (o Authorization: Bearer)
# Genera un secreto largo: openssl rand -hex 32
HERMES_BRIDGE_TOKEN=

# Auto-respuesta IA (webhooks OpenWA)
# URL pública HTTPS donde OpenWA puede enviar eventos (mismo servidor detrás de nginx)
# También la usa el panel para descargar CVs al agendar reuniones (/api/public/cv/:id)
WEBHOOK_PUBLIC_URL=
WEBHOOK_SECRET=
# Al arrancar, registra webhooks en OpenWA (default: true si WEBHOOK_PUBLIC_URL está definida)
AUTO_ACTIVATE_WEBHOOKS=true
# Poll de chats no leídos → mismo pipeline que POST /api/webhooks/openwa
# Default true si WEBHOOK_PUBLIC_URL es localhost. En producción déjalo false.
# OPENWA_INBOX_POLL=false
# OPENWA_INBOX_POLL_MS=3000
# AUTO_ACTIVATE_WEBHOOKS_DELAY_MS=3000
# AUTO_ACTIVATE_WEBHOOKS_RETRY_MS=30000
# AUTO_ACTIVATE_WEBHOOKS_MAX_ATTEMPTS=0
AUTO_REPLY_ENABLED=false
# Motor de respuestas: ollama | deepseek (default: ollama si OLLAMA_URL está definida)
# AI_REPLY_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_TIMEOUT_MS=120000
# OLLAMA_THINK=false
# Tiempo de "escribiendo…" (proporcional a la longitud del mensaje)
# Fórmula: BASE + (caracteres × MS_PER_CHAR), acotado entre MIN y MAX.
# Un párrafo ~150 caracteres ≈ 30s con los defaults.
# También se pueden ajustar MIN/MAX desde la UI (auto-respuesta); la UI tiene prioridad.
AUTO_REPLY_MIN_DELAY_MS=3000
AUTO_REPLY_MAX_DELAY_MS=35000
AUTO_REPLY_TYPING_BASE_MS=2500
AUTO_REPLY_TYPING_MS_PER_CHAR=200

# Intervalo aleatorio entre mensajes del envío masivo (segundos).
# También se ajusta desde la UI; la UI tiene prioridad sobre estas variables.
# SEND_MIN_DELAY_SEC=60
# SEND_MAX_DELAY_SEC=300
# Si true (default), al llegar un mensaje de alguien que no está en Mongo se da de alta solo
# (incluye contactos @lid de WhatsApp) para que la IA pueda contestar.
AUTO_REPLY_ENROLL_UNKNOWN=true
# Horas entre saludos de la IA (Hola / gusto saludarte). Default 4.
AUTO_REPLY_GREETING_COOLDOWN_HOURS=4

# Failover entre líneas al enviar (opcional)
# SEND_FAILOVER_HEALTH_RETRIES=2
# SEND_FAILOVER_LOCAL_RETRIES=2
# SEND_FAILOVER_HEALTH_WAIT_MS=3000

# Gateway Android (app agente en el celular)
# Token que debe enviar la app en header X-Android-Token
ANDROID_GATEWAY_TOKEN=

# Previews de conversaciones (evitar rate-limit OpenWA)
# CONVERSATIONS_PREVIEW_DELAY_MS=700
# CONVERSATIONS_PREVIEW_BATCH=12
# Hueco mínimo entre peticiones HTTP a OpenWA (ms). Default 400.
# OPENWA_MIN_GAP_MS=400
# Concurrencia al listar chats de varias sesiones. Default 1.
# CONVERSATIONS_LIST_CONCURRENCY=1

# Integración Panel — agendar reuniones (misma clave que MSG_INTEGRATION_API_KEY en panel)
PANEL_BASE_URL=https://panel.protalentconnections.com
MSG_INTEGRATION_API_KEY=
# Opcional: fallback si el usuario no guardó su correo en el perfil de la UI
MSG_GERENTE_EMAIL=
