# Copiar a .env junto a capataz_engine.py

# Bridge msg (mensajes entrantes vía webhooks → inbox)
HERMES_BRIDGE_URL=http://127.0.0.1:3445
HERMES_BRIDGE_TOKEN=tu_token_igual_que_en_msg

# OpenWA local — debe terminar en /api
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=tu_api_key_openwa

# Sesiones a vigilar (UUIDs). Vacío = auto-detecta CONNECTED vía GET /sessions
# OPENWA_SESSION_IDS=96a7db56-9181-4972-86f7-c595118669f9

# Polling directo a OpenWA si el inbox del bridge está vacío o falla webhooks
CAPATAZ_OPENWA_POLL=true

# Ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma2:27b

POLLING_INTERVAL_SEC=3
TYPING_MIN_SEC=2
TYPING_MAX_SEC=5
